# Copy this file to `.env` and pin a concrete version for reproducible transfers.
# See VERSIONS.md for the authoritative pins. Pin by DIGEST in production, not a tag.
#
# Record the digest once with:
#   docker pull ghcr.io/eschouten/ai-detector:latest
#   docker inspect --format '{{index .RepoDigests 0}}' ghcr.io/eschouten/ai-detector:latest

# AMD64 NVIDIA / CPU machines (dedicated CowVision PC) — replace with the @sha256 digest:
AIDETECTOR_IMAGE=ghcr.io/eschouten/ai-detector:latest
# e.g. AIDETECTOR_IMAGE=ghcr.io/eschouten/ai-detector@sha256:<digest>

# NVIDIA Jetson (JetPack 6) instead use (also pin by digest):
# AIDETECTOR_IMAGE=ghcr.io/eschouten/ai-detector:main-jetpack6

# Optional web UI image:
# AIDETECTOR_WEB_IMAGE=ghcr.io/eschouten/ai-detector-web:latest
